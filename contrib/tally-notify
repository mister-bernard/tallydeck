#!/usr/bin/python3
"""tally-notify — push raised deck questions to the operator's phone over Signal.

The deck only helps when the operator is at the desk. This daemon watches the
signals dir and, for every raised question (attention/blocked with a detail;
never an ask-<sid> session prompt), sends ONE Signal message with the ask and
its numbered options, and records it under ~/.tallydeck/pending/<id>.json so an
inbound matcher can resolve the operator's reply ("1", "A", a few words) into
~/.tallydeck/answers/<id>.json — the same file the deck popup writes, so the
raising agent's `tally wait` does not care which surface answered.

Re-sends only if the ask itself changed (sublabel/options), and never more
than once per RESEND_AFTER — a flag that is merely re-raised with new metadata
must not become four messages. When a flag is answered (answer file present)
a one-line confirmation goes out; when it just vanishes, the pending record
is dropped quietly.

DECK FIRST, PHONE WHEN AWAY (G, 2026-09-08): while a deck is connected the
hub touches ~/.tallydeck/hub.alive every few seconds. While that heartbeat is
fresh, nothing is sent — the question is on the keys in front of him. The
moment the deck is unplugged (heartbeat stale) any question still raised goes
to Signal, so work keeps moving while he is out. TALLY_ESCALATE_AFTER=<s>
optionally sends anyway once a question has waited that long at the deck.

    tally-notify [--once] [--dry-run] [--every 2]

Env: G_SIGNAL_NUMBER (recipient; from ~/.openclaw/.env), TALLY_SIGNAL_SEND
(default /home/openclaw/scripts/signal-send-logged.sh), TALLYDECK_STATE,
TALLY_DECK_FRESH (s, default 20), TALLY_ESCALATE_AFTER (s, default 0 = never).
"""
from __future__ import annotations

import argparse
import hashlib
import json
import os
import subprocess
import sys
import time
from pathlib import Path

RESEND_AFTER = 600.0          # s before a CHANGED ask may go out again
DECK_FRESH = float(os.environ.get("TALLY_DECK_FRESH", "20"))
ESCALATE_AFTER = float(os.environ.get("TALLY_ESCALATE_AFTER", "0"))
SEND = os.environ.get("TALLY_SIGNAL_SEND", "/home/openclaw/scripts/signal-send-logged.sh")
LABEL = "tally-notify"


def state_dir() -> Path:
    env = os.environ.get("TALLYDECK_STATE")
    if env:
        return Path(env).expanduser()
    try:
        import pwd
        return Path(pwd.getpwuid(os.getuid()).pw_dir) / ".tallydeck"
    except Exception:
        return Path.home() / ".tallydeck"


def log(msg: str) -> None:
    print(time.strftime("%H:%M:%S ") + msg, flush=True)


def compose(d: dict, sid: str) -> str:
    meta = d.get("meta") or {}
    state = "BLOCKED" if d.get("state") == "blocked" else "DECISION"
    lines = [f"◆ {state} — {d.get('label', sid)}", ""]
    sub = str(d.get("sublabel", "")).strip()
    det = str(d.get("detail", "")).strip()
    if sub:
        lines.append(sub)
    if det and det != sub:
        lines += ["", det]
    opts = [str(o) for o in (meta.get("options") or [])]
    if opts:
        lines.append("")
        lines += [f"{i} · {o}" for i, o in enumerate(opts, 1)]
        lines += ["", "Reply with the number, or a few words."]
    else:
        lines += ["", "Reply with a few words."]
    lines.append(f"[{sid}]")
    return "\n".join(lines)


def digest(d: dict) -> str:
    meta = d.get("meta") or {}
    raw = json.dumps([d.get("sublabel"), d.get("detail"), meta.get("options")], sort_keys=True)
    return hashlib.blake2b(raw.encode(), digest_size=8).hexdigest()


def send(to: str, text: str, dry: bool) -> bool:
    if dry:
        log(f"DRY-RUN → {to}:\n{text}\n")
        return True
    try:
        r = subprocess.run([SEND, to, LABEL, text], capture_output=True, text=True, timeout=40)
        if r.returncode != 0:
            log(f"send failed: {r.stderr.strip()[:200]}")
        return r.returncode == 0
    except (OSError, subprocess.TimeoutExpired) as e:
        log(f"send error: {e}")
        return False


def deck_connected(sd: Path, now: float) -> bool:
    try:
        return now - (sd / "hub.alive").stat().st_mtime < DECK_FRESH
    except OSError:
        return False


_last_presence: dict = {"deck": None}


def tick(sd: Path, to: str, dry: bool) -> None:
    signals, pending, answers = sd / "signals", sd / "pending", sd / "answers"
    pending.mkdir(parents=True, exist_ok=True)
    now = time.time()
    at_deck = deck_connected(sd, now)
    if _last_presence["deck"] is not at_deck:
        log("deck connected — questions stay on the keys" if at_deck
            else "no deck — questions go to Signal")
        _last_presence["deck"] = at_deck
    live: set[str] = set()
    for fp in sorted(signals.glob("*.json")):
        sid = fp.stem
        if sid.startswith("ask-"):
            continue                     # a live session's own prompt: not ours
        try:
            d = json.loads(fp.read_text())
        except (OSError, json.JSONDecodeError):
            continue
        if d.get("state") not in ("attention", "blocked") or not str(d.get("detail", "")).strip():
            continue
        ttl, upd = d.get("ttl"), float(d.get("updated", now))
        if ttl is not None and now - upd > float(ttl):
            continue                     # expired; the hub will reap it
        live.add(sid)
        pf = pending / f"{sid}.json"
        prev = {}
        if pf.is_file():
            try:
                prev = json.loads(pf.read_text())
            except json.JSONDecodeError:
                prev = {}
        dg = digest(d)
        if prev.get("digest") == dg:
            continue                     # already told him this exact ask
        if prev and now - float(prev.get("sent_at", 0)) < RESEND_AFTER:
            continue                     # changed, but too soon to nag
        if at_deck and not (ESCALATE_AFTER and now - upd > ESCALATE_AFTER):
            continue                     # he is at the deck: it is on the keys
        if send(to, compose(d, sid), dry):
            pf.write_text(json.dumps({
                "id": sid, "label": d.get("label", sid), "digest": dg,
                "options": (d.get("meta") or {}).get("options") or [],
                "sent_at": now, "updated": upd}))
            log(f"notified {sid}")
    # flags that went away: confirm if answered, else just forget
    for pf in pending.glob("*.json"):
        sid = pf.stem
        if sid in live:
            continue
        af = answers / f"{sid}.json"
        if af.is_file():
            try:
                a = json.loads(af.read_text())
                if not a.get("confirmed_signal"):
                    label = a.get("label") or sid
                    if send(to, f"✓ recorded — {label}: {a.get('answer', '')}", dry):
                        a["confirmed_signal"] = time.time()
                        af.write_text(json.dumps(a))
            except (OSError, json.JSONDecodeError):
                pass
        pf.unlink(missing_ok=True)


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--once", action="store_true")
    ap.add_argument("--dry-run", action="store_true")
    ap.add_argument("--every", type=float, default=2.0)
    a = ap.parse_args()
    to = os.environ.get("G_SIGNAL_NUMBER", "").strip()
    if not to and not a.dry_run:
        print("tally-notify: G_SIGNAL_NUMBER not set", file=sys.stderr)
        return 2
    sd = state_dir()
    log(f"watching {sd / 'signals'} → Signal {to or '(dry-run)'}")
    while True:
        try:
            tick(sd, to or "+0", a.dry_run)
        except Exception as e:              # a bad file must not kill the daemon
            log(f"tick error: {e!r}")
        if a.once:
            return 0
        time.sleep(a.every)


if __name__ == "__main__":
    sys.exit(main())
