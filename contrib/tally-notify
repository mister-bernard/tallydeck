#!/usr/bin/python3
"""tally-notify — push raised deck questions to the operator's phone over Signal.

The deck only helps when the operator is at the desk. This daemon watches the
signals dir and, for every raised question (attention/blocked with a detail;
never an ask-<sid> session prompt), sends ONE Signal message with the ask and
its numbered options, and records it under ~/.tallydeck/pending/<id>.json so an
inbound matcher can resolve the operator's reply ("1", "A", a few words) into
~/.tallydeck/answers/<id>.json — the same file the deck popup writes, so the
raising agent's `tally wait` does not care which surface answered.

Re-sends only if the ask itself changed (sublabel/options), and never more
than once per RESEND_AFTER — a flag that is merely re-raised with new metadata
must not become four messages. When a flag is answered (answer file present)
a one-line confirmation goes out; when it just vanishes, the pending record
is dropped quietly.

DECK FIRST, PHONE WHEN AWAY (G, 2026-09-08): while a deck is connected the
hub touches ~/.tallydeck/hub.alive every few seconds. While that heartbeat is
fresh, nothing is sent — the question is on the keys in front of him. The
moment the deck is unplugged (heartbeat stale) any question still raised goes
to Signal, so work keeps moving while he is out. TALLY_ESCALATE_AFTER=<s>
optionally sends anyway once a question has waited that long at the deck.

    tally-notify [--once] [--dry-run] [--every 2]

Env: G_SIGNAL_NUMBER (recipient; from ~/.openclaw/.env), TALLY_SIGNAL_SEND
(default /home/openclaw/scripts/signal-send-logged.sh), TALLYDECK_STATE,
TALLY_DECK_FRESH (s, default 20), TALLY_ESCALATE_AFTER (s, default 0 = never).
"""
from __future__ import annotations

import argparse
import hashlib
import json
import os
import subprocess
import sys
import time
from pathlib import Path

RESEND_AFTER = 600.0          # s before a CHANGED ask may go out again
BACKOFF_MAX = 300.0           # s cap on retry spacing after a failed send
SAFE_ID = __import__("re").compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$")
DECK_FRESH = float(os.environ.get("TALLY_DECK_FRESH", "20"))
ESCALATE_AFTER = float(os.environ.get("TALLY_ESCALATE_AFTER", "0"))
SEND = os.environ.get("TALLY_SIGNAL_SEND", "/home/openclaw/scripts/signal-send-logged.sh")
LABEL = "tally-notify"


def state_dir() -> Path:
    env = os.environ.get("TALLYDECK_STATE")
    if env:
        return Path(env).expanduser()
    try:
        import pwd
        return Path(pwd.getpwuid(os.getuid()).pw_dir) / ".tallydeck"
    except Exception:
        return Path.home() / ".tallydeck"


def log(msg: str) -> None:
    print(time.strftime("%H:%M:%S ") + msg, flush=True)


def compose(d: dict, sid: str) -> str:
    meta = d.get("meta") or {}
    state = "BLOCKED" if d.get("state") == "blocked" else "DECISION"
    lines = [f"◆ {state} — {d.get('label', sid)}", ""]
    sub = str(d.get("sublabel", "")).strip()
    det = " ".join(str(d.get("detail", "")).split())
    if sub:
        lines.append(sub)
    if det and det != sub:
        if len(det) > 600:
            det = det[:580].rsplit(" ", 1)[0] + " … (full brief on the deck)"
        lines += ["", det]
    opts = [str(o) for o in (meta.get("options") or [])]
    if opts:
        lines.append("")
        lines += [f"{i} · {o}" for i, o in enumerate(opts, 1)]
        lines += ["", "Reply with the number — or quote this message to answer in words."]
    else:
        lines += ["", "Quote this message to answer in words."]
    lines.append(f"[{sid}]")
    return "\n".join(lines)


def digest(d: dict) -> str:
    meta = d.get("meta") or {}
    raw = json.dumps([d.get("sublabel"), d.get("detail"), meta.get("options")], sort_keys=True)
    return hashlib.blake2b(raw.encode(), digest_size=8).hexdigest()


def send(to: str, text: str, dry: bool) -> bool:
    if dry:
        log(f"DRY-RUN → {to}:\n{text}\n")
        return True
    try:
        r = subprocess.run([SEND, to, LABEL, text], capture_output=True, text=True, timeout=40)
        if r.returncode != 0:
            log(f"send failed: {r.stderr.strip()[:200]}")
        return r.returncode == 0
    except (OSError, subprocess.TimeoutExpired) as e:
        log(f"send error: {e}")
        return False


def hushed(sd: Path, now: float):
    """Lift epoch (inf = open-ended) while ~/.tallydeck/hush is in force."""
    try:
        d = json.loads((sd / "hush").read_text())
    except (OSError, json.JSONDecodeError):
        return None
    until = d.get("until")
    if until is None:
        return float("inf")
    if float(until) <= now:
        (sd / "hush").unlink(missing_ok=True)
        return None
    return float(until)


def _hub_process_alive() -> bool:
    """A `tallydeck.cli serve` process exists only while a deck client holds
    the ssh pipe. Belt to the heartbeat's braces: a hub too old to write
    hub.alive (or one that is hung) still means the deck is plugged in —
    and plugged in means no phone (G, 2026-09-08)."""
    if os.environ.get("TALLY_DECK_PROC", "1") == "0":
        return False                      # tests / hosts where the hub is elsewhere
    me = os.getpid()
    try:
        for pid in os.listdir("/proc"):
            if not pid.isdigit() or int(pid) == me:
                continue
            try:
                with open(f"/proc/{pid}/cmdline", "rb") as fh:
                    argv = fh.read().split(b"\0")
            except OSError:
                continue
            if b"tallydeck.cli" in argv and b"serve" in argv:
                return True
    except OSError:
        pass
    return False


def deck_connected(sd: Path, now: float) -> bool:
    try:
        if now - (sd / "hub.alive").stat().st_mtime < DECK_FRESH:
            return True
    except OSError:
        pass
    return _hub_process_alive()


_last_presence: dict = {"deck": None}


def _read(fp: Path):
    try:
        d = json.loads(fp.read_text())
    except (OSError, ValueError):
        return None
    return d if isinstance(d, dict) else None


def _write(fp: Path, obj: dict) -> None:
    import tempfile
    fp.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=f".{fp.name}.", dir=str(fp.parent))
    with os.fdopen(fd, "w") as fh:
        fh.write(json.dumps(obj))
    os.replace(tmp, fp)


def tick(sd: Path, to: str, dry: bool) -> None:
    signals, pending, answers = sd / "signals", sd / "pending", sd / "answers"
    for d_ in (sd, pending, answers):
        try:
            d_.mkdir(parents=True, exist_ok=True)
            os.chmod(d_, 0o700)
        except OSError:
            pass
    now = time.time()
    at_deck = deck_connected(sd, now)
    if _last_presence["deck"] is not at_deck:
        log("deck connected — questions stay on the keys" if at_deck
            else "no deck — questions go to Signal")
        _last_presence["deck"] = at_deck
    hush_until = hushed(sd, now)
    if _last_presence.get("hush") != bool(hush_until):
        log("hushed — holding notifications" if hush_until else "unhushed")
        _last_presence["hush"] = bool(hush_until)
    quiet = (sd / "answer-quiet").exists()
    if _last_presence.get("quiet") != quiet:
        log("answer-quiet present — phone path OFF" if quiet else "answer-quiet lifted")
        _last_presence["quiet"] = quiet
    live: set[str] = set()
    for fp in sorted(signals.glob("*.json")):
        sid = fp.stem
        if sid.startswith("ask-") or not SAFE_ID.match(sid) or ".." in sid:
            continue                     # a live session's own prompt / not a name
        # Everything about ONE file stays inside its own try: a single
        # hand-written drop with "updated": null must not stop every other
        # question from reaching the phone, forever (audit P2-3).
        try:
            d = json.loads(fp.read_text())
            if not isinstance(d, dict):
                continue
            if d.get("state") not in ("attention", "blocked") \
                    or not str(d.get("detail", "")).strip():
                continue
            ttl = d.get("ttl")
            upd = float(d.get("updated") or now)
            if ttl is not None and now - upd > float(ttl):
                continue                 # expired; the hub will reap it
            live.add(sid)
            pf = pending / f"{sid}.json"
            prev = _read(pf) or {}
            dg = digest(d)
            opts = (d.get("meta") or {}).get("options") or []
            if prev.get("digest") == dg:
                # Unchanged ask. Retry only a FAILED send, with backoff.
                if prev.get("sent_at"):
                    continue
                if now - float(prev.get("fail_at") or 0) < min(
                        BACKOFF_MAX, 5.0 * 2 ** int(prev.get("fails") or 0)):
                    continue
            elif prev.get("sent_at") and now - float(prev["sent_at"]) < RESEND_AFTER:
                # Changed ask, too soon to nag. PARK the change: the digest and
                # option list G is answering against stay the ones that were
                # SENT (a bare "2" must never be scored against a list he has
                # not seen — round-2 P0-1); the stale digest keeps the change
                # visible so the resend fires once RESEND_AFTER passes.
                if prev.get("pending_digest") != dg:
                    _write(pf, {**prev, "pending_digest": dg, "updated": upd})
                continue
            if (answers / f"{sid}.json").is_file():
                continue                 # answered on another surface; delivery in flight
            if quiet or hush_until:
                continue                 # kill switch / do not disturb
            if at_deck and not (ESCALATE_AFTER and now - upd > ESCALATE_AFTER):
                continue                 # he is at the deck: it is on the keys
            if send(to, compose(d, sid), dry):
                _write(pf, {"id": sid, "label": d.get("label", sid), "digest": dg,
                            "options": opts, "sent_at": now, "updated": upd})
                log(f"notified {sid}")
            else:
                _write(pf, {"id": sid, "label": d.get("label", sid), "digest": dg,
                            "options": opts, "sent_at": None, "updated": upd,
                            "fail_at": now, "fails": int(prev.get("fails") or 0) + 1})
        except Exception as e:
            log(f"skip {sid}: {e!r}")
    # flags that went away: confirm if answered, say so if withdrawn
    for pf in pending.glob("*.json"):
        sid = pf.stem
        if sid in live:
            continue
        prev = _read(pf) or {}
        af = answers / f"{sid}.json"
        a = _read(af) if af.is_file() else None
        if a is not None:
            if not a.get("confirmed_signal") and prev.get("sent_at"):
                label = a.get("label") or sid
                if quiet or send(to, f"✓ recorded — {label}: {a.get('answer', '')}", dry):
                    a["confirmed_signal"] = time.time()
                    _write(af, a)
        elif prev.get("sent_at") and not quiet:
            # He may still reply to a question that no longer exists; say so
            # once rather than let that reply meet silence (audit P3).
            send(to, f"— withdrawn: {prev.get('label') or sid} (expired or dismissed)", dry)
        pf.unlink(missing_ok=True)


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--once", action="store_true")
    ap.add_argument("--dry-run", action="store_true")
    ap.add_argument("--every", type=float, default=2.0)
    a = ap.parse_args()
    to = os.environ.get("G_SIGNAL_NUMBER", "").strip()
    if not to and not a.dry_run:
        print("tally-notify: G_SIGNAL_NUMBER not set", file=sys.stderr)
        return 2
    sd = state_dir()
    shown = ("…" + to[-4:]) if to else "(dry-run)"
    log(f"watching {sd / 'signals'} → Signal {shown}")
    while True:
        try:
            tick(sd, to or "+0", a.dry_run)
        except Exception as e:              # a bad file must not kill the daemon
            log(f"tick error: {e!r}")
        if a.once:
            return 0
        time.sleep(a.every)


if __name__ == "__main__":
    sys.exit(main())
