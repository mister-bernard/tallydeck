#!/usr/bin/python3
"""tally-offer <slug> "<one-line summary>" [-c cwd] [-a A|B|O] [--harness claude|codex] [-p task-file|-] [task text]

Kept as the compatibility name for `tally spawn`. It no longer asks anything.

It used to raise "Run separately? 1 · yes 2 · here" on the deck and hold the
work until the operator answered — which made the answer a precondition for
the work starting at all (G, 2026-09-08: "that's actually a blocker because
the process doesn't actually spawn until I give it yet another response").

The judgement belongs to the agent, not to the operator: an agent that thinks
a task deserves its own session runs this (or `tally spawn`) and the session
starts immediately; an agent that thinks the task belongs in the current
session simply does the work inline and never calls this at all. Either way
nobody is asked to choose.

The new session appears as its own deck key the moment its log does — that IS
the notification. Nothing is raised, nothing waits.

Task text: positional, -p file, or -p - (stdin); it is what the dedicated
session receives as its first prompt. Falls back to the summary.
"""
from __future__ import annotations

import os
import subprocess
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
REPO = HERE.parent
if not (REPO / "tallydeck").is_dir():
    import pwd
    REPO = Path(os.environ.get("TALLYDECK_HOME", str(Path(pwd.getpwuid(os.getuid()).pw_dir) / "projects/tallydeck")))
sys.path.insert(0, str(REPO))
from tallydeck.launch import resolve_launch
from tallydeck.paths import safe_id
SPAWN = os.environ.get("TALLY_SPAWN_BIN") or str(HERE / "tally-spawn")


def main(argv: list[str]) -> int:
    if len(argv) < 2 or argv[0] in ("-h", "--help"):
        print(__doc__, file=sys.stderr); return 2
    slug, summary = argv[0], argv[1]
    if not safe_id(slug):
        print("tally-offer: invalid slug", file=sys.stderr); return 2
    rest = argv[2:]
    cwd, acct, harness, task = os.getcwd(), "", "", ""
    i = 0
    while i < len(rest):
        a = rest[i]
        if a in ("-c", "-a", "--account", "--harness", "-p") and i + 1 >= len(rest):
            print(f"tally-offer: {a} needs a value", file=sys.stderr); return 2
        if a == "-c": cwd = rest[i + 1]; i += 2
        elif a in ("-a", "--account"): acct = rest[i + 1]; i += 2
        elif a == "--harness": harness = rest[i + 1]; i += 2
        elif a == "-p":
            task = sys.stdin.read() if rest[i + 1] == "-" else Path(rest[i + 1]).read_text(); i += 2
        elif a.startswith("--"):
            print(f"tally-offer: unknown option {a}", file=sys.stderr); return 2
        else: task = a; i += 1
    # Resolve here as well as in tally-spawn: a bad account/harness should be a
    # message to the agent that asked for it, not a half-built tmux session.
    try:
        route = resolve_launch(acct, harness)
    except ValueError as e:
        print(f"tally-offer: {e}", file=sys.stderr); return 2
    task = task.strip() or summary

    launch = [SPAWN, slug, "-c", cwd, "-a", route["account"], "--harness", route["harness"], "-p", "-"]
    sp = subprocess.run(launch, input=task, capture_output=True, text=True, timeout=60)
    if sp.returncode != 0:
        # The caller is a live agent mid-turn: tell it plainly, so it can run
        # the work inline instead of dropping it.
        print(f"tally-offer: spawn failed: {sp.stderr.strip()[:200] or 'unknown error'} — run it here instead",
              file=sys.stderr)
        return 1
    name = sp.stdout.strip()
    print(f"spawned {name} ({route['harness']} / account {route['account']}, cwd {cwd}) — {summary}")
    print("It has its own session and deck key; do not also run it here.")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
