#!/usr/bin/env bash
# tally-route <client_tty> <cur_sess> <target> <uuid> <project> <label> <state> [account]
#
# The attention router, run INSIDE a floating tmux popup (80% x 70%) over
# whatever the operator is viewing. The underlying view is NEVER touched:
#
#   Enter → the popup ITSELF becomes the session (nested attach). Work in
#           it, then Ctrl-b d detaches and the popup vanishes — you're back
#           exactly where you were.
#   b     → link the pressed session's window into your current session's
#           window list (reversible; the source session keeps it)
#   r     → (paneless) resume the Claude session in a NEW tmux session,
#           attached floating in this popup; Ctrl-b d leaves it running
#           and it shows up on the deck as a live pane from then on
#   other → dismiss, nothing changed
set -u
TTY="${1:-}"; CUR="${2:-}"; TARGET="${3:-}"; UUID="${4:-}"
PROJ="${5:-}"; LABEL="${6:-}"; STATE="${7:-}"; ACCT="${8:-}"
SOCKET="${TALLY_TMUX_SOCKET:-/tmp/tmux-1000/cc}"
T() { tmux -S "$SOCKET" "$@"; }
export PYTHONPATH="$HOME/projects/tallydeck${PYTHONPATH:+:$PYTHONPATH}"

# Which claude binary owns this session's history (account B has its own HOME).
BIN="claude"
[ "$ACCT" = "B" ] && BIN="$HOME/.local/bin/claude-b"

/usr/bin/python3 -m tallydeck.cli brief \
  --session "$UUID" --project "$PROJ" --label "$LABEL" --state "$STATE"

if [ -n "$TARGET" ]; then
  printf '  \033[1;96m[⏎]\033[0m open here, floating (Ctrl-b d to put it back)   \033[1;96m[b]\033[0m add to my windows   \033[2mother → dismiss\033[0m\n'
else
  printf '  \033[1;96m[r]\033[0m resume here, floating (Ctrl-b d keeps it running)   \033[2mother → dismiss\033[0m\n'
fi
read -r -n 1 -s -t 120 key 2>/dev/null || exit 0

if [ -n "$TARGET" ]; then
  SESS="${TARGET%%:*}"
  case "$key" in
    "")   # Enter: the popup becomes the session — no client is redirected
      T select-window -t "${TARGET%.*}" 2>/dev/null
      T select-pane -t "$TARGET" 2>/dev/null
      unset TMUX
      exec tmux -S "$SOCKET" attach -t "$SESS" ;;
    b|B)  # bring it into my window list
      WID=$(T display -p -t "$TARGET" '#{window_id}' 2>/dev/null)
      [ -n "$WID" ] || exit 0
      if ! T list-windows -t "$CUR" -F '#{window_id}' 2>/dev/null \
           | grep -qx "$WID"; then
        T link-window -a -s "$WID" -t "$CUR:" 2>/dev/null
      fi
      T select-window -t "$WID" 2>/dev/null
      T select-pane -t "$TARGET" 2>/dev/null ;;
  esac
elif { [ "$key" = "r" ] || [ "$key" = "R" ]; } && [ -n "$UUID" ]; then
  NAME="fl-$(printf '%s' "${LABEL:-sess}" | tr -c 'a-zA-Z0-9_-' '-' | cut -c1-24)"
  if ! T has-session -t "=$NAME" 2>/dev/null; then
    T new-session -d -s "$NAME" -c "${PROJ:-$HOME}" \
      "$BIN --resume '$UUID'; exec bash -l"
  fi
  unset TMUX
  exec tmux -S "$SOCKET" attach -t "=$NAME"
fi
exit 0
