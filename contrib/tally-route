#!/usr/bin/env bash
# tally-route <client_tty> <cur_sess> <target> <uuid> <project> <label> <state>
#
# The attention router. Runs INSIDE a full-screen tmux popup over whatever
# the operator is currently viewing — nothing moves until they choose:
#
#   Enter  → switch this client to the pressed session (go there)
#   b      → bring the pressed session's window INTO the current session
#            (link-window; reversible, the source session keeps it too)
#   r      → resume the Claude session in a new window here (no live pane)
#   other  → dismiss, nothing changes
set -u
TTY="${1:-}"; CUR="${2:-}"; TARGET="${3:-}"; UUID="${4:-}"
PROJ="${5:-}"; LABEL="${6:-}"; STATE="${7:-}"
SOCKET="${TALLY_TMUX_SOCKET:-/tmp/tmux-1000/cc}"
T() { tmux -S "$SOCKET" "$@"; }
export PYTHONPATH="$HOME/projects/tallydeck${PYTHONPATH:+:$PYTHONPATH}"

/usr/bin/python3 -m tallydeck.cli brief \
  --session "$UUID" --project "$PROJ" --label "$LABEL" --state "$STATE"

if [ -n "$TARGET" ]; then
  printf '  \033[1;96m[⏎]\033[0m go there   \033[1;96m[b]\033[0m bring window here   \033[2many other key → dismiss\033[0m\n'
else
  printf '  \033[1;96m[r]\033[0m resume session in a window here   \033[2many other key → dismiss\033[0m\n'
fi
read -r -n 1 -s -t 120 key 2>/dev/null || exit 0

if [ -n "$TARGET" ]; then
  SESS="${TARGET%%:*}"
  case "$key" in
    "")   # Enter: take me to it
      T switch-client -c "$TTY" -t "$TARGET" 2>/dev/null ;;
    b|B)  # bring it here: link the window into the current session
      WID=$(T display -p -t "$TARGET" '#{window_id}' 2>/dev/null)
      [ -n "$WID" ] || exit 0
      if ! T list-windows -t "$CUR" -F '#{window_id}' 2>/dev/null \
           | grep -qx "$WID"; then
        T link-window -a -s "$WID" -t "$CUR:" 2>/dev/null
      fi
      T select-window -t "$WID" 2>/dev/null
      T select-pane -t "$TARGET" 2>/dev/null ;;
  esac
elif [ "$key" = "r" ] || [ "$key" = "R" ] && [ -n "$UUID" ]; then
  T new-window -a -t "$CUR:" -c "${PROJ:-$HOME}" \
    "claude --resume '$UUID'" 2>/dev/null
fi
exit 0
