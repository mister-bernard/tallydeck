#!/usr/bin/env bash
# tally-route <client_tty> <cur_sess> <target> <uuid> <project> <label> <state> [account] [signal_id] [ask]
#
# The attention router, run inside a floating tmux popup over whatever the
# operator is viewing. One menu, always — every option works whether the
# session has a live pane or must be resurrected:
#
#   Enter → GO THERE, floating: live pane → grouped view (own selection,
#           nothing shared moves); dead → resume attached here.
#           Ctrl-b d puts it back / leaves it running.
#   t     → open it as a TAB (window) of your current session
#   s     → SPLIT it into your current window, side by side
#   ␣     → DONE: mute this alert until the session asks anew; for a raised
#           flag (`tally raise` / hook) this retires the flag itself
#   other → dismiss; nothing anywhere changes
#
# A raised flag with no session behind it still gets the popup: the ask is
# shown, ␣ retires it, anything else leaves it flashing. Reading is not
# acknowledging.
set -u
TTY="${1:-}"; CUR="${2:-}"; TARGET="${3:-}"; UUID="${4:-}"
PROJ="${5:-}"; LABEL="${6:-}"; STATE="${7:-}"; ACCT="${8:-}"
SIGID="${9:-}"; ASK="${10:-}"
SOCKET="${TALLY_TMUX_SOCKET:-/tmp/tmux-1000/cc}"
T() { tmux -S "$SOCKET" "$@"; }
export PYTHONPATH="${TALLYDECK_HOME:-$HOME/projects/tallydeck}${PYTHONPATH:+:$PYTHONPATH}"

# The Mac's CUR is a snapshot; the client may have switched since. Resolve
# fresh, from in here, where the server is one call away.
LIVE_CUR=$(T display -p -t "$TTY" '#{client_session}' 2>/dev/null)
[ -n "$LIVE_CUR" ] && CUR="$LIVE_CUR"

# Reap leftover floating groups nobody is attached to. destroy-unattached
# cannot be used here (set-option rejects the '=' prefix, and the reaper
# races the attach — an unattached group dies in <200ms, faster than we can
# attach to it) — explicit cleanup is the reliable version. Also heals
# groups leaked by earlier versions.
T list-sessions -F '#{session_name} #{session_attached}' 2>/dev/null \
  | while read -r name attached; do
      case "$name" in
        _fl-*) [ "$attached" = "0" ] && T kill-session -t "$name" 2>/dev/null ;;
      esac
    done

# A recorded pane can die between the alert and the press (hook asks carry
# panes up to 30 min old). A dead target must downgrade to the resume flow,
# not fail into a silently empty popup.
if [ -n "$TARGET" ] && ! T display -p -t "$TARGET" '#{pane_id}' >/dev/null 2>&1; then
  TARGET=""
fi

# Which binary owns this session's history (account B has its own HOME).
BIN="claude"
[ "$ACCT" = "B" ] && BIN="$HOME/.local/bin/claude-b"
printf -v RESUME '%q --dangerously-skip-permissions --resume %q; exec bash -l' "$BIN" "$UUID"
case "$SIGID" in
  cx/*)
    printf -v RESUME '%q resume --dangerously-bypass-approvals-and-sandbox %q; exec bash -l' "${CODEX_BIN:-codex}" "$UUID" ;;
  gk/*|hunt/*)
    GROK=1 ;;
esac
# Hook-raised ask-* keys carry the session uuid, not gk/<uuid>. Account X
# is Grok; resuming those as Claude opened a dead "openclaw" overlay with
# nothing to type into.
[ "$ACCT" = "X" ] && GROK=1
if [ "${GROK:-0}" = 1 ]; then
    # Grok resume is cwd-sensitive (sessions are grouped by encoded cwd) and
    # must --always-approve or the resurrected TUI parks on a permission
    # prompt — the blank-window failure this branch exists to close.
    GROK_BIN="${GROK_BIN:-$HOME/.local/bin/grok}"
    printf -v RESUME 'cd %q && env HOME=%q %q --always-approve --resume %q; exec bash -l' \
      "${PROJ:-$HOME}" "$HOME" "$GROK_BIN" "$UUID"
fi

# Terminals answer queries (the DA1 reply "^[[?1;2c") and those bytes arrive
# as INPUT — drain before the menu read, or they dismiss the router; drain
# before any attach, or they land in a Claude prompt as a typed line.
drain_input() { while read -r -s -n 10000 -t 0.05 _ 2>/dev/null; do :; done; }

ensure_resurrected() {
  NAME="fl-${UUID:-x}"   # uuid-keyed: labels collide
  if ! T has-session -t "=$NAME" 2>/dev/null; then
    T new-session -d -s "$NAME" -c "${PROJ:-$HOME}" "$RESUME"
  fi
}

# Raised decisions go straight to the answer UI. Session permission hooks keep
# their own routing controls: their answer belongs in the waiting agent pane.
case "$SIGID" in
  sig/ask-*) ;;
  sig/*)
    DECIDE="${TALLY_DECIDE:-$(dirname "$(realpath "$0")")/tally-decide}"
    exec "$DECIDE" "${SIGID#sig/}" ;;
esac
LIVE=""; [ -n "$TARGET" ] && LIVE=1
TAKEN_DIR="${TALLYDECK_STATE:-$HOME/.tallydeck}/route-taken"
TAKEN="$TAKEN_DIR/$(printf '%s' "${SIGID:-x}" | tr '/' '_')"
ACTIONS="space done (mute) · q / Esc dismiss"
if [ -n "$LIVE" ] || [ -n "$UUID" ]; then
  ACTIONS="1-9 next step · i type a reply · Enter open · t tab · x close (park) · $ACTIONS"
fi
ACTION_FILE=$(mktemp)
trap 'rm -f "$ACTION_FILE"' EXIT
/usr/bin/python3 -m tallydeck.cli brief \
  --session "$UUID" --project "$PROJ" --label "$LABEL" --state "$STATE" \
  --ask "$ASK" --signal "$SIGID" --interactive --actions "$ACTIONS" \
  --taken "$TAKEN" --action-file "$ACTION_FILE" || exit 1
# read without stripping Enter, which is itself the floating action.
key=""; IFS= read -r -N 1 key < "$ACTION_FILE" || true
[ -s "$ACTION_FILE" ] || exit 0
# First terminal to act wins atomically; scrolling never claims the press.
mkdir -p "$TAKEN_DIR"
(set -o noclobber; : > "$TAKEN") 2>/dev/null || exit 0

SESS="${TARGET%%:*}"
case "$key" in
  [1-9])  # pick a numbered next step from the brief and send it to the pane
    n=$key
    step=$(printf '%s\n' "$ASK" | sed -n "s/^[[:space:]]*${n}[.)][[:space:]]*//p" | head -1)
    if [ -z "$step" ]; then
      echo "  no option $n in the next-steps list"
      sleep 1.4
      exit 0
    fi
    DEST="$TARGET"
    if [ -z "$DEST" ] && [ -n "$UUID" ]; then
      ensure_resurrected
      DEST="${NAME}:1.1"
    fi
    if [ -z "$DEST" ]; then
      echo "  no live pane to send that to"
      sleep 1.4
      exit 0
    fi
    T send-keys -t "$DEST" -l -- "Do this next: $step"
    T send-keys -t "$DEST" Enter
    echo "  sent option $n."
    sleep 0.6
    exit 0 ;;
  x|X)  # CLOSE: park the session — save resume id, free RAM, drop the key
    echo
    echo "  parking ${LABEL:-session} — saved, resumable, dropping from the deck"
    /usr/bin/python3 - "$SESS" "$UUID" "$PROJ" "$ACCT" "$SIGID" "$TARGET" <<'PY'
import os, sys
sys.path.insert(0, os.environ.get("TALLYDECK_HOME", os.path.expanduser("~/projects/tallydeck")))
from tallydeck.park import park
slug, uuid, cwd, acct, sigid, target = sys.argv[1:7]
harness = "grok" if (sigid.startswith("gk/") or sigid.startswith("hunt/") or acct == "X") else (
    "codex" if sigid.startswith("cx/") or acct in ("O", "O2") else "claude")
rec = park(slug=slug, uuid=uuid, cwd=cwd, harness=harness, account=acct, target=target)
print("  resume:", rec.get("resume") or "(no uuid — reported only)")
PY
    sleep 1.6
    exit 0 ;;
  i|I|/)  # TYPE A REPLY into the live pane so a flashing key is steerable
          # from this window, not only after attaching to the TUI.
    if [ -z "$LIVE" ] && [ -z "$TARGET" ]; then
      echo "  no live pane to type into — Enter to resume the session first"
      sleep 2
      exit 0
    fi
    echo
    printf '  Steer the session (blank cancels): '
    IFS= read -r reply || true
    [ -n "$reply" ] || exit 0
    DEST="$TARGET"
    if [ -z "$DEST" ] && [ -n "$UUID" ]; then
      ensure_resurrected
      DEST="$NAME"
    fi
    # -l is literal: a reply containing ; or $ must not become tmux syntax.
    T send-keys -t "$DEST" -l -- "$reply"
    T send-keys -t "$DEST" Enter
    echo "  sent."
    sleep 0.6
    exit 0 ;;
  l|L)  # TEXT ME THE LINKS — tmux swallows clickable links; the phone does not
    if [ -n "$UUID" ]; then
      "$(dirname "$(realpath "$0")")/tally-link" "$UUID" "${LABEL:-session}"
      sleep 2
    else
      echo "  no session behind this key — nothing to pull links from"; sleep 2
    fi
    exit 0 ;;
  " ")  # DONE — inbox-style: mute this alert until the session asks anew
    STATE_DIR="${TALLYDECK_STATE:-$HOME/.tallydeck}"
    if [ -n "$UUID" ]; then
      SID8=$(printf '%s' "$UUID" | cut -c1-8)
      case "$SIGID" in cx/*) SID8="$UUID" ;; esac
      rm -f "$STATE_DIR/signals/ask-$SID8.json"
      mkdir -p "$STATE_DIR/acked"
      touch "$STATE_DIR/acked/$SID8"
    fi
    # A raised flag is retired outright: "done" on a flag means the flag.
    case "$SIGID" in
      sig/*) /usr/bin/python3 -m tallydeck.cli clear "${SIGID#sig/}" >/dev/null 2>&1 || true ;;
    esac
    exit 0 ;;
  $'\n'|$'\r'|""|r|R)  # GO THERE, floating
    if [ -n "$LIVE" ]; then
      GRP="_fl-${SESS}"
      if ! T has-session -t "=$GRP" 2>/dev/null; then
        T new-session -d -s "$GRP" -t "$SESS" 2>/dev/null
      fi
      # Window part of the target, selected ONLY in our group — everyone
      # else's view stays put. (The old fallback built =grp:sess:1, a
      # malformed target; the window index must be split out first.)
      W="${TARGET#*:}"
      T select-window -t "=$GRP:${W%%.*}" 2>/dev/null
      drain_input; unset TMUX
      tmux -S "$SOCKET" attach -t "=$GRP"
      T kill-session -t "=$GRP" 2>/dev/null    # tidy on the way out
      exit 0
    elif [ -n "$UUID" ]; then
      ensure_resurrected
      drain_input; unset TMUX
      exec tmux -S "$SOCKET" attach -t "=$NAME"
    fi ;;
  t|T|b|B)  # a tab (window) in the current session
    if [ -n "$LIVE" ]; then
      WID=$(T display -p -t "$TARGET" '#{window_id}' 2>/dev/null)
      [ -n "$WID" ] || exit 0
      T list-windows -t "$CUR" -F '#{window_id}' 2>/dev/null | grep -qx "$WID" \
        || T link-window -a -s "$WID" -t "$CUR:" 2>/dev/null
      T select-window -t "$WID" 2>/dev/null
      T select-pane -t "$TARGET" 2>/dev/null
      T display-message -c "$TTY" "linked here — 'unlink-window' sends it back" 2>/dev/null
    elif [ -n "$UUID" ]; then
      T new-window -a -t "$CUR:" -c "${PROJ:-$HOME}" "$RESUME" 2>/dev/null
    fi ;;
  s|S)  # split into the current window
    if [ -n "$LIVE" ]; then
      if T join-pane -h -s "$TARGET" -t "$CUR:" 2>/dev/null; then
        T display-message -c "$TTY" "moved here — 'break-pane' sends it back out" 2>/dev/null
      else
        T display-message -c "$TTY" "split failed — that pane may be its window's only one" 2>/dev/null
      fi
    elif [ -n "$UUID" ]; then
      T split-window -h -t "$CUR:" -c "${PROJ:-$HOME}" "$RESUME" 2>/dev/null
    fi ;;
esac
exit 0
