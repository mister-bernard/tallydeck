#!/usr/bin/python3
"""Clear the deck's hook-raised signal once the session got its answer.
Same per-user state dir as tally-hook-notify (passwd home, not $HOME)."""
import json, sys, os


def state_dir():
    env = os.environ.get("TALLYDECK_STATE")
    if env:
        return os.path.expanduser(env)
    try:
        import pwd
        home = pwd.getpwuid(os.getuid()).pw_dir
    except Exception:
        home = os.path.expanduser("~")
    return os.path.join(home, ".tallydeck")


try:
    d = json.load(sys.stdin)
    full = d.get("session_id") or ""
    sid = full[:8]
    if sid:
        try:
            os.unlink(os.path.join(state_dir(), "signals", f"ask-{sid}.json"))
        except OSError:
            pass
        # Session → pane, recorded from inside the pane. The deck's live scan
        # can only see a session while a tool subprocess exists; this file
        # makes the identity durable (a key must not read "(resumes)" for a
        # session that is right there). Throttled: at most once a minute.
        # `-t $TMUX_PANE` below, and TMUX_PANE required here: a bare
        # `display -p` answers for the CURRENT pane of the attached client, so
        # a background session would record the operator's foreground pane as
        # its own identity — the durable record would then send answers and
        # presses to the wrong agent.
        if os.environ.get("TMUX") and os.environ.get("TMUX_PANE"):
            import time
            pdir = os.path.join(state_dir(), "panes")
            pf = os.path.join(pdir, f"{sid}.json")
            try:
                fresh = time.time() - os.stat(pf).st_mtime < 60
            except OSError:
                fresh = False
            if not fresh:
                import subprocess
                out = subprocess.run(["tmux", "display", "-p", "-t", os.environ["TMUX_PANE"],
                                      "#S:#I.#P|#S|#{session_windows}|#W"],
                                     capture_output=True, text=True, timeout=2).stdout.strip()
                target, _, rest = out.partition("|")
                if target:
                    os.makedirs(pdir, exist_ok=True)
                    tmp = pf + f".{os.getpid()}"
                    with open(tmp, "w") as fh:
                        json.dump({"session": full, "tmux": target, "t": time.time(),
                                   "socket": (os.environ.get("TMUX") or "").split(",")[0]}, fh)
                    os.replace(tmp, pf)
except Exception:
    pass
sys.exit(0)
