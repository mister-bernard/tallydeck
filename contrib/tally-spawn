#!/usr/bin/env bash
# tally-spawn <slug> [-c cwd] [-a A|B|1|2|X] [--harness claude|codex|grok] [-p task-file|-] [--force] [--share] [--worktree] ["task text"]
#
# Start a piece of work as ITS OWN tmux session, so it gets its own key on the
# deck the moment its log appears (the session source labels keys by tmux
# session name) and keeps chugging along without anyone reading its scroll.
#
#   tally spawn wires-nhd -c ~/projects/wires "Rebuild the NHD datum, run the suite, push."
#   printf '%s' "$LONG_TASK" | tally spawn aurora-sim -c ~/aurora -p -
#
# --worktree gives the lane its OWN git worktree and branch (lane/<slug>) under
# ~/.worktrees/<repo>/<slug>, so several lanes can work one repo in parallel
# instead of being serialised by the claim registry — or worse, each wandering
# off into a repo of its own. Close it with `tally close <slug>`, which commits,
# merges back and removes the tree. Use it for BUILD lanes.
#
# The calling harness/account is inherited unless overridden. The task is its first prompt.
# The session is recorded in
# ~/.tallydeck/spawned/<slug>.json (target, cwd, account, when, who spawned it).
# Slugs are unique per socket: a second "wires-nhd" becomes "wires-nhd-2".
#
# Spawning is ADMISSION-CONTROLLED (see the gate below): a spawn that would
# start on a box with no memory left is refused, with the numbers, rather than
# quietly becoming the swap exhaustion that kills something else. `--force`
# (or TALLY_SPAWN_NO_GATE=1) overrides.
set -uo pipefail
SOCKET="${TALLY_TMUX_SOCKET:-/tmp/tmux-1000/cc}"
STATE="${TALLYDECK_STATE:-$(getent passwd "$(id -u)" | cut -d: -f6)/.tallydeck}"
TASK_REPO="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
if [ ! -d "$TASK_REPO/tallydeck" ]; then
  TASK_REPO="${TALLYDECK_HOME:-$(getent passwd "$(id -u)" | cut -d: -f6)/projects/tallydeck}"
fi
export PYTHONPATH="$TASK_REPO${PYTHONPATH:+:$PYTHONPATH}"
T() { tmux -S "$SOCKET" "$@"; }

usage() { sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'; }
case "${1:-}" in ""|-h|--help) usage >&2; exit 2 ;; esac
SLUG="$1"; shift
case "$SLUG" in *[!A-Za-z0-9._-]*|.*) echo "tally-spawn: bad slug '$SLUG'" >&2; exit 2 ;; esac
CWD="$HOME"; ACCT=""; HARNESS=""; TASK=""; FORCE="${TALLY_SPAWN_NO_GATE:-0}"
# Whether -c was given explicitly. An explicit -c is a DECLARATION of the work tree,
# so it is claimed; the $HOME default is not a declaration and claiming it would let
# the first default spawn block every later one.
CWD_EXPLICIT=0; SHARE=0; WORKTREE=0
while [ $# -gt 0 ]; do
  case "$1" in -c|-a|--account|--harness|-p)
    [ $# -ge 2 ] || { echo "tally-spawn: $1 needs a value" >&2; exit 2; } ;;
  esac
  case "$1" in
    -c) CWD="$2"; CWD_EXPLICIT=1; shift 2 ;;
    -a|--account) ACCT="$2"; shift 2 ;;
    --harness) HARNESS="$2"; shift 2 ;;
    -p) if [ "$2" = "-" ]; then TASK="$(cat)"; else TASK="$(cat "$2")" || exit 2; fi; shift 2 ;;
    --force) FORCE=1; shift ;;
    --share) SHARE=1; shift ;;
    --worktree) WORKTREE=1; shift ;;
    --*) echo "tally-spawn: unknown option $1" >&2; exit 2 ;;
    *)  TASK="$1"; shift ;;
  esac
done
[ -n "$TASK" ] || { echo "tally-spawn: no task given" >&2; exit 2; }
[ -d "$CWD" ] || { echo "tally-spawn: no such dir $CWD" >&2; exit 2; }

# ── --worktree: parallel lanes in ONE repo ──────────────────────────────────
# Until now our only isolation was the claim registry, which SERIALISES: one
# writer per tree, second writer refused. That is correct and it is also why the
# repo count exploded — a lane that needed to work alongside another had nowhere
# to go but a new repo, so SubnetBridge ossified into 13 of them (2026-09-11
# sweep). Worktrees are the missing third option: N writers, one repo, N trees,
# each on its own branch.
#
# The claim is then taken on the WORKTREE path, not the parent repo, so parallel
# lanes no longer collide — while two lanes handed the same worktree still do.
# That is the property worth keeping: isolation per tree, not per repo.
#
# Learned from dmux (MIT), which makes worktree-per-task its default. We took
# the model and left the rest; see reference_dmux_hijacks_live_panes.
if [ "$WORKTREE" = 1 ]; then
  REPO_ROOT="$(git -C "$CWD" rev-parse --show-toplevel 2>/dev/null)" || {
    echo "tally-spawn: --worktree needs a git repo; $CWD is not in one" >&2; exit 2; }
  REPO_NAME="$(basename "$REPO_ROOT")"
  BASE_REF="$(git -C "$REPO_ROOT" rev-parse --abbrev-ref HEAD 2>/dev/null)"
  [ -n "$BASE_REF" ] && [ "$BASE_REF" != HEAD ] || BASE_REF="$(git -C "$REPO_ROOT" rev-parse HEAD)"
  WT_ROOT="${TALLY_WORKTREE_ROOT:-/home/openclaw/.worktrees}/$REPO_NAME"
  WT_PATH="$WT_ROOT/$SLUG"
  BRANCH="lane/$SLUG"
  mkdir -p "$WT_ROOT"
  if [ -d "$WT_PATH" ]; then
    # Reusing a lane's tree silently is how two tasks end up sharing a branch.
    echo "tally-spawn: REFUSED '$SLUG' — worktree already exists at $WT_PATH" >&2
    echo "  finish or close that lane first:  tally close $SLUG" >&2
    exit 3
  fi
  if git -C "$REPO_ROOT" show-ref --verify --quiet "refs/heads/$BRANCH"; then
    echo "tally-spawn: REFUSED '$SLUG' — branch $BRANCH already exists" >&2
    echo "  close the previous lane, or pick another slug." >&2
    exit 3
  fi
  git -C "$REPO_ROOT" worktree add -b "$BRANCH" "$WT_PATH" "$BASE_REF" >&2 || {
    echo "tally-spawn: worktree add failed" >&2; exit 3; }
  echo "tally-spawn: lane tree $WT_PATH on $BRANCH (from $BASE_REF)" >&2
  CWD="$WT_PATH"; CWD_EXPLICIT=1
fi

# ── Admission control ────────────────────────────────────────────────────────
# A session is not free. Measured on this box 2026-09-09: 89 resident agent
# processes holding 8.1 GiB RSS + 10.2 GiB swap = 210 MB of COMMITTED memory
# each. Spawning was unconditional, so a fan-out could — and on 2026-09-09
# 02:32:35 did — walk the box into swap exhaustion, at which point the kernel
# OOM killer took out nine processes across seven services.
#
# So: refuse a spawn the box cannot afford, and say why in numbers. The floors
# are deliberately a few sessions' worth of headroom, not one — the gate has to
# trip BEFORE the fleet overshoots, and nothing re-checks between two spawns
# issued back to back.
#
#   MIN_AVAIL_MB   1024 ≈ 5 sessions of real RAM. Below this the next fan-out
#                  is paid for out of swap.
#   MIN_SWAP_FREE  512 MB. Swap exhaustion, NOT RAM exhaustion, is what invokes
#                  the OOM killer here — the incident ran 15/15 GiB of swap.
#                  Skipped when the box has no swap configured.
#
# Override per-call with --force, globally with TALLY_SPAWN_NO_GATE=1, or tune
# with TALLY_SPAWN_MIN_AVAIL_MB / TALLY_SPAWN_MIN_SWAP_FREE_MB.
MIN_AVAIL_MB="${TALLY_SPAWN_MIN_AVAIL_MB:-1024}"
MIN_SWAP_FREE_MB="${TALLY_SPAWN_MIN_SWAP_FREE_MB:-512}"

# TALLY_MEMINFO exists so the gate can be tested against a described machine
# rather than against whatever this box happens to be doing; in production it
# is always /proc/meminfo.
MEMINFO="${TALLY_MEMINFO:-/proc/meminfo}"
mem_kb() { awk -v k="$1" '$1==k":"{print $2; found=1} END{if(!found) print 0}' "$MEMINFO"; }

if [ "$FORCE" != 1 ]; then
  # Sample twice and keep the WORSE reading. Under the pressure this gate
  # exists for, MemAvailable and SwapFree oscillate hard — measured here
  # swinging 0 ↔ 350MB of free swap within seconds as reclaim churns. A single
  # sample lands in a lucky window often enough to matter: the first live test
  # of this gate was admitted on a spike while the box was, in fact, out of
  # swap. The floor has to hold, not merely have held once.
  avail=$(( $(mem_kb MemAvailable) / 1024 ))
  swap_total=$(( $(mem_kb SwapTotal) / 1024 ))
  swap_free=$(( $(mem_kb SwapFree) / 1024 ))
  sleep 0.3
  a2=$(( $(mem_kb MemAvailable) / 1024 )); [ "$a2" -lt "$avail" ] && avail=$a2
  s2=$(( $(mem_kb SwapFree) / 1024 ));     [ "$s2" -lt "$swap_free" ] && swap_free=$s2
  reason=""
  if [ "$avail" -lt "$MIN_AVAIL_MB" ]; then
    reason="available RAM ${avail}MB < ${MIN_AVAIL_MB}MB"
  elif [ "$swap_total" -gt 0 ] && [ "$swap_free" -lt "$MIN_SWAP_FREE_MB" ]; then
    reason="free swap ${swap_free}MB of ${swap_total}MB < ${MIN_SWAP_FREE_MB}MB"
  fi
  if [ -n "$reason" ]; then
    nsess=$(T list-sessions 2>/dev/null | wc -l)
    cat >&2 <<EOF
tally-spawn: REFUSED '$SLUG' — not enough memory to start another session.
  $reason
  now: ${avail}MB available RAM, ${swap_free}MB/${swap_total}MB free swap, ${nsess} tmux sessions
  a session costs ~210MB committed, so this spawn would come out of swap.

  Free some first:   tally reap            (report idle sessions)
                     tally reap --reap     (reap them; each is resumable)
  Continue this task inline. Do not retry or bypass the gate without a new explicit G instruction.
EOF
    exit 3
  fi
fi

ROUTE="$(python3 -m tallydeck.launch "$ACCT" "$HARNESS")" || exit 2
mapfile -t FIELDS <<< "$ROUTE"
HARNESS="${FIELDS[0]}"; ACCT="${FIELDS[1]}"; BIN="${FIELDS[2]}"
LAUNCH_HOME="${FIELDS[3]}"; LAUNCH_CODEX_HOME="${FIELDS[4]:-}"

NAME="$SLUG"; n=2
while T has-session -t "=$NAME" 2>/dev/null; do NAME="$SLUG-$n"; n=$((n+1)); done

# ── Ownership claim ─────────────────────────────────────────────────────────
# The duplicate-writer failure this closes: on 2026-09-09 taobridge-contracts was
# handed to a batch one-shot and an interactive pane two minutes apart, on the same
# account. Claiming in ONE launcher would have left that intact, because the two
# writers came from two launchers — so codex-oneshot (-W) and this must consult the
# same registry, and they do.
#
# Claimed here, before the session is created, so a refusal costs nothing: no tmux
# session, no agent process, no half-briefed worker to clean up. The claim is taken
# as tally-spawn's own pid and ADOPTED over to the pane below, because the pane does
# not exist yet and going free in between is the race we are closing.
CLAIM=/home/openclaw/scripts/work-claim.py
CLAIMED=""
if [ "$CWD_EXPLICIT" = 1 ] && [ "$SHARE" != 1 ] && [ -x "$CLAIM" ]; then
  if "$CLAIM" acquire "$CWD" --owner "spawn:$NAME" --pid $$ --launcher tally-spawn \
       --task "$SLUG" >/dev/null 2>&1; then
    CLAIMED="$CWD"
  else
    holder="$("$CLAIM" check "$CWD" 2>&1 | sed 's/^/  /')"
    cat >&2 <<EOF
tally-spawn: REFUSED '$SLUG' — another worker already owns $CWD.
$holder
  Two writers in one tree is the failure this gate exists for; the second one
  silently overwrites the first's edits and neither knows.

  If the holder is LIVE:  wait for it, or give this worker its own tree.
  If it is STALE:         the owner's process is gone but its work may be half
                          written — look before taking over, then
                          $CLAIM acquire "$CWD" --owner "spawn:$NAME" --force
  Read-only alongside it: re-run with --share (records no claim).
EOF
    exit 3
  fi
fi
# Release the reservation if we die before the pane can adopt it — otherwise a
# failed spawn leaves a claim owned by a pid that is already gone, locking the tree.
spawn_cleanup() { [ -n "$CLAIMED" ] && "$CLAIM" release "$CLAIMED" --owner "spawn:$NAME" --force >/dev/null 2>&1; return 0; }
trap spawn_cleanup EXIT



mkdir -p "$STATE/spawned" "$STATE/tasks"; chmod 700 "$STATE" 2>/dev/null
TASKF="$STATE/tasks/$NAME.md"; umask 077
{
  cat <<'WORKER_PROTOCOL'
You are already the dedicated worker for this task. Complete it in this session.
Do not spawn another session, subagent, or one-shot worker unless G explicitly
 authorizes further delegation for this task. Task duration alone is not
 authorization. Work inline with the tools available here. Independent audits
 explicitly required by the applicable build lifecycle remain authorized.
If a spawn is refused for memory pressure, continue that task inline: do not
retry, rename it, or bypass the memory gate on a transient improvement.
Before finishing, deliver the outcome and save artifact locations, pending
 decisions, and exact resume information. Then release this completed worker
 through the existing safe parking/reaping mechanism; never kill an active or
 ambiguously identified worker. Do not remain resident waiting for more work.

Task:
WORKER_PROTOCOL
  printf '%s\n' "$TASK"
} > "$TASKF"
# Folder trust is PER-HOME. A claude session launched into a cwd that its
# account has never seen stops at the "Quick safety check" dialog — whose cursor
# defaults to "No, exit" — and just sits there, or dies if anything answers it
# blindly. Account B has its own HOME, so a dir trusted on A is still untrusted
# for B: on 2026-09-09 three `tally spawn -a B` sessions parked this way at once.
# Seed the trust entry for the resolved HOME first and the dialog never appears.
if [ "$HARNESS" != codex ] && [ "$HARNESS" != grok ] && [ -x /home/openclaw/scripts/claude-trust.sh ]; then
  /home/openclaw/scripts/claude-trust.sh trust "$CWD" "$LAUNCH_HOME" >&2 || \
    echo "tally-spawn: trust pre-provision failed for $CWD ($LAUNCH_HOME) — session may park at the trust dialog" >&2
fi

# Keep task text out of tmux's command; the interactive CLI receives it at launch.
TARGET="$(T new-session -d -P -F '#{session_name}:#{window_index}.#{pane_index}' -s "$NAME" -c "$CWD" \
  -e "TALLY_TASK_FILE=$TASKF" -e "TALLY_AGENT_BIN=$BIN" -e "TALLY_SPAWNED=$NAME" \
  -e "TALLY_HARNESS=$HARNESS" -e "TALLY_ACCOUNT=$ACCT" \
  -e "TALLY_LAUNCH_HOME=$LAUNCH_HOME" -e "TALLY_CODEX_HOME=$LAUNCH_CODEX_HOME" \
  -e "TALLY_OOM_ADJ=${TALLY_OOM_ADJ:-800}" \
  'unset CODEX_THREAD_ID CLAUDE_SESSION_ID CLAUDE_CODE_SESSION_ID CLAUDECODE CLAUDE_CONFIG_DIR CODEX_HOME SESSION_ID TELEGRAPH_PANE_SESSION_ID TELEGRAPH_ORIGIN_JSON;
   export HOME="$TALLY_LAUNCH_HOME";
   # Volunteer as the OOM killer'"'"'s first choice. An agent session is
   # RESUMABLE (claude --resume <uuid>); pearl-vault-relay losing its state
   # mid-flight is not. Raising oom_score_adj needs no privilege — only
   # LOWERING it does — so this works from an unprivileged tmux pane, and the
   # child agent inherits it. Together with the -1000/-900 pins on the money
   # and messaging units, a fan-out that overcommits now kills the fan-out.
   echo "$TALLY_OOM_ADJ" > /proc/self/oom_score_adj 2>/dev/null || true;
   printf "\n=== tally spawn :: %s :: %s / %s ===\n\n" "$TALLY_SPAWNED" "$TALLY_HARNESS" "$TALLY_ACCOUNT";
   if [ "$TALLY_HARNESS" = codex ]; then
     unset OPENAI_API_KEY ANTHROPIC_API_KEY;
     export CODEX_HOME="$TALLY_CODEX_HOME";
     "$TALLY_AGENT_BIN" --dangerously-bypass-approvals-and-sandbox "$(cat "$TALLY_TASK_FILE")";
   elif [ "$TALLY_HARNESS" = grok ]; then
     # --always-approve is grok'"'"'s equivalent of the codex/claude bypass flags.
     # ANTHROPIC/OPENAI keys are unset for the same reason codex unsets them: a
     # stray key in the environment silently reroutes the agent to a metered API.
     # This lane runs on the SuperGrok subscription via ~/.grok/auth.json, which
     # is why HOME must stay the operator home and not an account config dir.
     unset OPENAI_API_KEY ANTHROPIC_API_KEY XAI_API_KEY;
     "$TALLY_AGENT_BIN" --always-approve "$(cat "$TALLY_TASK_FILE")";
   else
     "$TALLY_AGENT_BIN" --dangerously-skip-permissions "$(cat "$TALLY_TASK_FILE")";
   fi;
   echo; echo "[tally-spawn] $TALLY_HARNESS exited; shell remains."; exec bash -i')" \
  || { echo "tally-spawn: tmux new-session failed" >&2; exit 1; }

# Hand the claim to the pane. From here the CLAIM'S LIFETIME IS THE WORKER'S: the
# registry reads it live while that process exists and stale the moment it does not,
# which is why ownership is proved by a process and never by a timestamp.
if [ -n "$CLAIMED" ]; then
  PANE_PID="$(T display -p -t "$TARGET" '#{pane_pid}' 2>/dev/null)"
  if [ -n "$PANE_PID" ] && "$CLAIM" adopt "$CLAIMED" --owner "spawn:$NAME" --pid "$PANE_PID" \
       --task "$SLUG" >/dev/null 2>&1; then
    CLAIMED=""   # the pane owns it now; our EXIT trap must not take it back
  else
    echo "tally-spawn: WARNING could not hand the claim on $CWD to the pane — releasing it." >&2
    echo "  The session is running but UNCLAIMED: another launcher may be admitted here." >&2
  fi
fi

python3 - "$STATE/spawned/$NAME.json" "$NAME" "$CWD" "$ACCT" "$TASKF" "$HARNESS" "$TARGET" \
         "${REPO_ROOT:-}" "${BRANCH:-}" "${BASE_REF:-}" <<'PY'
import json, os, sys, time
from tallydeck.launch import caller_harness
p, name, cwd, acct, taskf, harness, target = sys.argv[1:8]
repo_root, branch, base_ref = (sys.argv[8:11] + ["", "", ""])[:3]
# Worktree lanes record the repo, branch and base they came from — `tally close`
# cannot merge and clean up a lane whose provenance it has to guess.
wt = ({"repo_root": repo_root, "branch": branch, "base_ref": base_ref}
      if repo_root and branch else {})
json.dump({"slug": name, "target": target, "cwd": cwd, "account": acct, "harness": harness,
           "task_file": taskf, "at": time.time(), **({"worktree": wt} if wt else {}),
           "origin_session": (os.environ.get("CODEX_THREAD_ID", "") if caller_harness(dict(os.environ)) == "codex" else os.environ.get("CLAUDE_SESSION_ID", "") or os.environ.get("CLAUDE_CODE_SESSION_ID", "")),
           "origin_pane": os.environ.get("TMUX_PANE", "")}, open(p, "w"))
PY
echo "$NAME"
