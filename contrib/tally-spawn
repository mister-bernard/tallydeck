#!/usr/bin/env bash
# tally-spawn <slug> [-c cwd] [-a A|B|1|2] [--harness claude|codex] [-p task-file|-] ["task text"]
#
# Start a piece of work as ITS OWN tmux session, so it gets its own key on the
# deck the moment its log appears (the session source labels keys by tmux
# session name) and keeps chugging along without anyone reading its scroll.
#
#   tally spawn wires-nhd -c ~/projects/wires "Rebuild the NHD datum, run the suite, push."
#   printf '%s' "$LONG_TASK" | tally spawn aurora-sim -c ~/aurora -p -
#
# The calling harness/account is inherited unless overridden. The task is its first prompt.
# The session is recorded in
# ~/.tallydeck/spawned/<slug>.json (target, cwd, account, when, who spawned it).
# Slugs are unique per socket: a second "wires-nhd" becomes "wires-nhd-2".
set -uo pipefail
SOCKET="${TALLY_TMUX_SOCKET:-/tmp/tmux-1000/cc}"
STATE="${TALLYDECK_STATE:-$(getent passwd "$(id -u)" | cut -d: -f6)/.tallydeck}"
TASK_REPO="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
if [ ! -d "$TASK_REPO/tallydeck" ]; then
  TASK_REPO="${TALLYDECK_HOME:-$(getent passwd "$(id -u)" | cut -d: -f6)/projects/tallydeck}"
fi
export PYTHONPATH="$TASK_REPO${PYTHONPATH:+:$PYTHONPATH}"
T() { tmux -S "$SOCKET" "$@"; }

usage() { sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'; }
case "${1:-}" in ""|-h|--help) usage >&2; exit 2 ;; esac
SLUG="$1"; shift
case "$SLUG" in *[!A-Za-z0-9._-]*|.*) echo "tally-spawn: bad slug '$SLUG'" >&2; exit 2 ;; esac
CWD="$HOME"; ACCT=""; HARNESS=""; TASK=""
while [ $# -gt 0 ]; do
  case "$1" in -c|-a|--account|--harness|-p)
    [ $# -ge 2 ] || { echo "tally-spawn: $1 needs a value" >&2; exit 2; } ;;
  esac
  case "$1" in
    -c) CWD="$2"; shift 2 ;;
    -a|--account) ACCT="$2"; shift 2 ;;
    --harness) HARNESS="$2"; shift 2 ;;
    -p) if [ "$2" = "-" ]; then TASK="$(cat)"; else TASK="$(cat "$2")" || exit 2; fi; shift 2 ;;
    --*) echo "tally-spawn: unknown option $1" >&2; exit 2 ;;
    *)  TASK="$1"; shift ;;
  esac
done
[ -n "$TASK" ] || { echo "tally-spawn: no task given" >&2; exit 2; }
[ -d "$CWD" ] || { echo "tally-spawn: no such dir $CWD" >&2; exit 2; }

ROUTE="$(python3 -m tallydeck.launch "$ACCT" "$HARNESS")" || exit 2
mapfile -t FIELDS <<< "$ROUTE"
HARNESS="${FIELDS[0]}"; ACCT="${FIELDS[1]}"; BIN="${FIELDS[2]}"
LAUNCH_HOME="${FIELDS[3]}"; LAUNCH_CODEX_HOME="${FIELDS[4]:-}"

NAME="$SLUG"; n=2
while T has-session -t "=$NAME" 2>/dev/null; do NAME="$SLUG-$n"; n=$((n+1)); done

mkdir -p "$STATE/spawned" "$STATE/tasks"; chmod 700 "$STATE" 2>/dev/null
TASKF="$STATE/tasks/$NAME.md"; umask 077; printf '%s\n' "$TASK" > "$TASKF"
# Keep task text out of tmux's command; the interactive CLI receives it at launch.
TARGET="$(T new-session -d -P -F '#{session_name}:#{window_index}.#{pane_index}' -s "$NAME" -c "$CWD" \
  -e "TALLY_TASK_FILE=$TASKF" -e "TALLY_AGENT_BIN=$BIN" -e "TALLY_SPAWNED=$NAME" \
  -e "TALLY_HARNESS=$HARNESS" -e "TALLY_ACCOUNT=$ACCT" \
  -e "TALLY_LAUNCH_HOME=$LAUNCH_HOME" -e "TALLY_CODEX_HOME=$LAUNCH_CODEX_HOME" \
  'unset CODEX_THREAD_ID CLAUDE_SESSION_ID CLAUDE_CODE_SESSION_ID CLAUDECODE CLAUDE_CONFIG_DIR CODEX_HOME SESSION_ID TELEGRAPH_PANE_SESSION_ID TELEGRAPH_ORIGIN_JSON;
   export HOME="$TALLY_LAUNCH_HOME";
   printf "\n=== tally spawn :: %s :: %s / %s ===\n\n" "$TALLY_SPAWNED" "$TALLY_HARNESS" "$TALLY_ACCOUNT";
   if [ "$TALLY_HARNESS" = codex ]; then
     unset OPENAI_API_KEY ANTHROPIC_API_KEY;
     export CODEX_HOME="$TALLY_CODEX_HOME";
     "$TALLY_AGENT_BIN" --dangerously-bypass-approvals-and-sandbox "$(cat "$TALLY_TASK_FILE")";
   else
     "$TALLY_AGENT_BIN" --dangerously-skip-permissions "$(cat "$TALLY_TASK_FILE")";
   fi;
   echo; echo "[tally-spawn] $TALLY_HARNESS exited; shell remains."; exec bash -i')" \
  || { echo "tally-spawn: tmux new-session failed" >&2; exit 1; }

python3 - "$STATE/spawned/$NAME.json" "$NAME" "$CWD" "$ACCT" "$TASKF" "$HARNESS" "$TARGET" <<'PY'
import json, os, sys, time
from tallydeck.launch import caller_harness
p, name, cwd, acct, taskf, harness, target = sys.argv[1:8]
json.dump({"slug": name, "target": target, "cwd": cwd, "account": acct, "harness": harness,
           "task_file": taskf, "at": time.time(),
           "origin_session": (os.environ.get("CODEX_THREAD_ID", "") if caller_harness(dict(os.environ)) == "codex" else os.environ.get("CLAUDE_SESSION_ID", "") or os.environ.get("CLAUDE_CODE_SESSION_ID", "")),
           "origin_pane": os.environ.get("TMUX_PANE", "")}, open(p, "w"))
PY
echo "$NAME"
