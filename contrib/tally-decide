def _write_atomic(fp: Path, obj: dict, exclusive: bool = False) -> bool:
    """Temp file + os.replace (never a torn read); exclusive = first writer
    wins via os.link, the loser gets False."""
    import tempfile
    fp.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=f".{fp.name}.", dir=str(fp.parent))
    try:
        with os.fdopen(fd, "w") as fh:
            fh.write(json.dumps(obj))
        if exclusive:
            try:
                os.link(tmp, fp)
            except FileExistsError:
                return False
            return True
        os.replace(tmp, fp)
        return True
    finally:
        try:
            os.unlink(tmp)
        except OSError:
            pass

console = Console(color_system="truecolor", theme=THEME)


# ── pieces ───────────────────────────────────────────────────────────────────

def _age(seconds: float) -> str:
    s = int(seconds)
    return f"{s}s" if s < 60 else f"{s // 60}m" if s < 3600 else f"{s // 3600}h{(s % 3600) // 60:02d}"


def _gradient_rule(width: int, a=(123, 136, 255), b=(255, 178, 36)) -> Text:
    t = Text()
    for i in range(width):
        k = i / max(1, width - 1)
        rgb = tuple(int(a[j] * (1 - k) + b[j] * k) for j in range(3))
        t.append("━", style=f"rgb({rgb[0]},{rgb[1]},{rgb[2]})")
    return t


def _header(d: dict, width: int) -> Group:
    state = str(d.get("state", "attention"))
    chip = Text(f" ◆ {'BLOCKED' if state == 'blocked' else 'DECISION'} ",
                style=f"bold black on {AMBER if state != 'blocked' else '#E5484D'}")
    title = Text(f"  {d.get('label', '?')}", style=f"bold {FG}")
    meta = Text(f"   raised {_age(time.time() - float(d.get('updated', time.time())))} ago",
                style=DIM)
    right = Text("· tallydeck", style=DIM)
    line = Table.grid(expand=True)
    line.add_column(justify="left")
    line.add_column(justify="right")
    line.add_row(Text.assemble(chip, title, meta), right)
    return Group(_gradient_rule(width), line, _gradient_rule(width))


def _body(d: dict) -> Panel:
    md = str((d.get("meta") or {}).get("markdown") or "").strip()
    if md:
        content = Markdown(md, code_theme="monokai", inline_code_theme="monokai")
    else:
        sub = str(d.get("sublabel", "")).strip()
        det = str(d.get("detail", "")).strip()
        parts = [f"## {sub}" if sub else ""]
        if det and det != sub:
            parts.append(det)
        content = Markdown("\n\n".join(p for p in parts if p))
    return Panel(content, box=box.ROUNDED, border_style=INDIGO,
                 padding=(1, 3), title=Text("the ask", style=DIM),
                 title_align="left")


def _options(opts: list[str]):
    """Option cards in an even grid, three to a row."""
    if not opts:
        return None
    cards = []
    for i, o in enumerate(opts[:9], 1):
        key = Text(f" {i} ", style=f"bold black on {AMBER}")
        body = Text.assemble(key, Text("  " + o, style=f"bold {FG}"))
        cards.append(Panel(body, box=box.ROUNDED, border_style=INDIGO if i == 1 else DIM,
                           padding=(0, 1), expand=True))
    per = 3 if len(cards) > 2 else len(cards)
    grid = Table.grid(expand=True, padding=(0, 1))
    for _ in range(per):
        grid.add_column(ratio=1)
    for r in range(0, len(cards), per):
        row = cards[r:r + per]
        grid.add_row(*(row + [Text("")] * (per - len(row))))
    return grid


def _footer(has_opts: bool, msg: str = "") -> Text:
    t = Text()
    if msg:
        t.append(msg + "   ", style=f"bold {AMBER}")
    if has_opts:
        t.append(" 1-9 ", style=f"bold black on {INDIGO}")
        t.append(" pick   ", style=DIM)
    t.append(" a ", style=f"bold black on {INDIGO}")
    t.append(" answer in words   ", style=DIM)
    t.append(" ⏎ ", style=f"bold black on {DIM}")
    t.append(" leave it raised   ", style=DIM)
    t.append(" esc ", style=f"bold black on {DIM}")
    t.append(" dismiss", style=DIM)
    return t


def screen(d: dict, opts: list[str], msg: str = "") -> Group:
    w = console.width
    parts = [_header(d, w), Text(""), _body(d)]
    o = _options(opts)
    if o is not None:
        parts += [Text(""), o]
    parts += [Text(""), _footer(bool(opts), msg)]
    return Group(*parts)


# ── input ────────────────────────────────────────────────────────────────────

def _getkey(timeout: float = 300.0, gone=None) -> str:
    """One keypress, raw; '' on timeout or when `gone()` turns true (the
    same question is shown on every attached terminal — once it is answered
    on one, the others fold quietly). Drains terminal query replies first."""
    import select, termios, tty
    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    try:
        tty.setcbreak(fd)
        while select.select([fd], [], [], 0.05)[0]:      # drain DA1 etc.
            os.read(fd, 4096)
        deadline = time.time() + timeout
        while time.time() < deadline:
            if select.select([fd], [], [], 0.5)[0]:
                return os.read(fd, 16).decode("utf-8", "ignore")
            if gone is not None and gone():
                return ""
        return ""
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)


def _reveal(renderable) -> None:
    """Materialize: the screen prints in top-down over ~0.3 s."""
    with console.capture() as cap:
        console.print(renderable)
    lines = cap.get().split("\n")
    console.clear()
    for ln in lines:
        sys.stdout.write(ln + "\n")
        sys.stdout.flush()
        time.sleep(min(0.008, 0.2 / max(1, len(lines))))


def _fireworks(seconds: float = 0.6) -> None:
    """A burst over the whole popup, then it clears itself."""
    w, h = console.width, max(10, console.height - 2)
    rnd = random.Random(7)
    bursts = [(rnd.uniform(0.25, 0.75) * w, rnd.uniform(0.3, 0.6) * h,
               rnd.uniform(0.0, 0.35), [(rnd.uniform(0, 2 * math.pi), rnd.uniform(0.35, 1.0))
                                        for _ in range(26)])
              for _ in range(4)]
    glyphs = "✦✧·∘•*+"
    t0 = time.time()
    with Live(console=console, refresh_per_second=30, transient=True, screen=True) as live:
        while True:
            el = time.time() - t0
            if el > seconds:
                break
            grid = [[" "] * w for _ in range(h)]
            styles = [[None] * w for _ in range(h)]
            for bx, by, delay, parts in bursts:
                p = (el - delay) / (seconds - delay)
                if p < 0:
                    continue
                for ang, spd in parts:
                    r = (1 - (1 - p) ** 2) * spd * min(w, h * 2) * 0.28
                    x = int(bx + math.cos(ang) * r)
                    y = int(by + math.sin(ang) * r * 0.5 + p * p * 3)   # gravity
                    if 0 <= x < w and 0 <= y < h:
                        k = max(0.0, 1 - p)
                        col = (int(255 * k + 123 * (1 - k)), int(178 * k + 136 * (1 - k)),
                               int(36 * k + 255 * (1 - k)))
                        grid[y][x] = glyphs[min(len(glyphs) - 1, int(p * len(glyphs)))]
                        styles[y][x] = f"rgb({col[0]},{col[1]},{col[2]})"
            out = Text()
            for y in range(h):
                for x in range(w):
                    out.append(grid[y][x], style=styles[y][x])
                out.append("\n")
            live.update(out)
            time.sleep(1 / 30)


def _recorded(d: dict, answer: str) -> Group:
    big = Text.assemble(("  ✓  ", f"bold {GREEN}"), ("recorded", f"bold {FG}"))
    ans = Panel(Text(answer, style=f"bold {AMBER}"), box=box.HEAVY, border_style=GREEN,
                padding=(1, 3))
    return Group(_gradient_rule(console.width), Text(""), big, Text(""), ans, Text(""),
                 Text("sent to the session that asked · flag cleared", style=DIM))


# ── main ─────────────────────────────────────────────────────────────────────

def list_raised() -> int:
    t = Table(box=box.SIMPLE, header_style=DIM)
    t.add_column("id"); t.add_column("label"); t.add_column("ask")
    n = 0
    for f in sorted(SIGNALS.glob("*.json")):
        try:
            d = json.loads(f.read_text())
        except Exception:
            continue
        t.add_row(f.stem, str(d.get("label", "")), str(d.get("sublabel", ""))[:60]); n += 1
    console.print(t if n else Text("(nothing raised)", style=DIM))
    return 0


def main(argv: list[str]) -> int:
    if not argv or argv[0] == "--list":
        return list_raised()
    if argv[0] == "--deliver":
        return deliver(*argv[1:5])
    sid = argv[0]
    import re as _re
    if not _re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{0,63}", sid) or ".." in sid:
        console.print(Text(f"bad signal id: {sid!r}", style="bold red")); return 1
    f = SIGNALS / f"{sid}.json"
    if not f.is_file():
        console.print(Text(f"No such raised decision: {sid}", style="bold red"))
        list_raised(); time.sleep(3); return 1
    d = None
    for _ in range(5):                       # a raise may be mid-rewrite
        try:
            d = json.loads(f.read_text())
            break
        except (OSError, ValueError):
            time.sleep(0.1)
    if not isinstance(d, dict):
        console.print(Text(f"{sid}: unreadable flag", style="bold red")); time.sleep(2); return 1
    opts = [str(o) for o in ((d.get("meta") or {}).get("options") or [])]

    _reveal(screen(d, opts))
    msg = ""
    answer = ""
    while True:
        key = _getkey(gone=lambda: not f.exists() or (ANSWERS / f"{sid}.json").exists())
        if key in ("", "\x1b", "q", "Q"):
            console.clear(); return 0                      # dismiss, flag stays
        if key in ("\r", "\n"):
            console.clear()
            console.print(Text("left raised — decide later", style=DIM)); time.sleep(0.8)
            return 0
        if key.isdigit() and opts and 1 <= int(key) <= len(opts):
            answer = f"{key} — {opts[int(key) - 1]}"
            break
        if key in ("a", "A", "/", " "):
            console.clear(); console.print(screen(d, opts, "your answer:"))
            try:
                console.print(Text("› ", style=f"bold {AMBER}"), end="")
                answer = input().strip()
            except (EOFError, KeyboardInterrupt):
                answer = ""
            if answer and not f.exists():
                console.clear()
                console.print(Text("already answered elsewhere", style=DIM)); time.sleep(1)
                return 0
            if answer:
                break
            _reveal(screen(d, opts)); continue
        msg = "1-9 picks an option · a to type" if opts else "a to type an answer"
        console.clear(); console.print(screen(d, opts, msg))

    ts = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
    # The answer file FIRST, exclusively: the first surface to answer wins,
    # a second (other terminal, phone) learns it lost instead of overwriting.
    if not _write_atomic(ANSWERS / f"{sid}.json",
                         {"id": sid, "answer": answer, "at": ts,
                          "label": d.get("label", ""), "via": "deck-popup"},
                         exclusive=True):
        prev = {}
        try:
            prev = json.loads((ANSWERS / f"{sid}.json").read_text())
        except (OSError, ValueError):
            pass
        console.clear()
        console.print(Text(f"already answered elsewhere: {prev.get('answer', '?')}", style=DIM))
        time.sleep(1.2)
        return 0
    try:
        LOG.parent.mkdir(parents=True, exist_ok=True)
        with open(LOG, "a") as fh:
            fh.write(f"[{ts}] {sid} :: {answer}\n")
    except OSError:
        pass                                 # the answer file is the record

    # Deliver + clear in a detached pass so the popup can vanish now.
    subprocess.Popen([sys.executable, os.path.abspath(__file__), "--deliver", sid,
                      str(d.get("label", sid)), answer, ts],
                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL, start_new_session=True)
    _fireworks()
    console.clear()
    return 0


TMUX_SOCKET = os.environ.get("TALLY_TMUX_SOCKET", "/tmp/tmux-1000/cc")


def _pane_of_session(session_id: str) -> str:
    """tmux target of the pane whose process tree carries this
    CLAUDE_SESSION_ID (only visible while a tool subprocess is alive, or via
    the claude process itself). '' if not found."""
    if not session_id:
        return ""
    try:
        r = subprocess.run(["tmux", "-S", TMUX_SOCKET, "list-panes", "-a", "-F",
                            "#{session_name}:#{window_index}.#{pane_index} #{pane_pid}"],
                           capture_output=True, text=True, timeout=3)
        ps = subprocess.run(["ps", "-eo", "pid=,ppid="], capture_output=True, text=True, timeout=3)
    except (OSError, subprocess.TimeoutExpired):
        return ""
    kids: dict = {}
    for ln in ps.stdout.splitlines():
        parts = ln.split()
        if len(parts) == 2:
            kids.setdefault(int(parts[1]), []).append(int(parts[0]))
    want = f"CLAUDE_SESSION_ID={session_id}".encode()
    for ln in (r.stdout or "").splitlines():
        parts = ln.split()
        if len(parts) != 2 or not parts[1].isdigit():
            continue
        stack, seen = [int(parts[1])], 0
        while stack and seen < 64:
            pid = stack.pop(); seen += 1
            try:
                env = Path(f"/proc/{pid}/environ").read_bytes()
            except OSError:
                env = b""
            if want in env.split(b"\0"):
                return parts[0]
            stack.extend(kids.get(pid, []))
    return ""


def _pane_alive(target: str) -> bool:
    try:
        return subprocess.run(["tmux", "-S", TMUX_SOCKET, "display", "-p", "-t", target,
                               "#{pane_id}"], capture_output=True, timeout=3).returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        return False


def _paste_into_pane(target: str, text: str) -> bool:
    """One line into a Claude pane, the way Telegraph does it: buffer +
    bracketed paste, then Enter. Control characters stripped first."""
    import re as _re
    clean = _re.sub(r"[\x00-\x08\x0b-\x1f\x7f]", " ", text).strip()
    buf = f"tally-{os.getpid()}-{int(time.time() * 1000)}"
    T = ["tmux", "-S", TMUX_SOCKET]
    try:
        subprocess.run(T + ["load-buffer", "-b", buf, "-"], input=clean, text=True,
                       check=True, timeout=5)
        subprocess.run(T + ["paste-buffer", "-p", "-d", "-b", buf, "-t", target],
                       check=True, timeout=5)
        time.sleep(0.15)
        subprocess.run(T + ["send-keys", "-t", target, "Enter"], check=True, timeout=5)
        return True
    except (OSError, subprocess.CalledProcessError, subprocess.TimeoutExpired):
        return False


def deliver(sid: str, label: str, answer: str, ts: str) -> int:
    """Background half of an answer: tell the session that asked, then clear
    the flag LAST. No-op unless the answer on disk is the one we were handed
    (a lost race must not deliver, and must not clear the winner's flag)."""
    import re as _re
    if not _re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{0,63}", sid) or ".." in sid:
        return 1
    f = SIGNALS / f"{sid}.json"
    try:
        cur = json.loads((ANSWERS / f"{sid}.json").read_text())
    except (OSError, ValueError):
        cur = {}
    if cur.get("at") != ts or cur.get("answer") != answer:
        return 1
    flag = {}
    try:
        flag = json.loads(f.read_text())
    except (OSError, ValueError):
        pass
    meta = flag.get("meta") or {}
    session = str(meta.get("session") or "")
    pane = str(meta.get("raiser_pane") or "")
    if pane and not _pane_alive(pane):
        pane = ""
    if not pane and session:
        pane = _pane_of_session(session)
    delivered = False
    if pane:
        delivered = _paste_into_pane(
            pane, f"[tally] decision for {sid} ({label}): {answer}  "
                  f"— answered on the deck at {ts}; `tally wait {sid} --json` has it.")
    try:
        with open(LOG, "a") as fh:
            fh.write(f"[{ts}] {sid} :: delivered to pane {pane}\n" if delivered else
                     f"[{ts}] {sid} :: no live pane for the raiser; answer file only\n")
    except OSError:
        pass
    try:
        if os.access(TALLY_BIN, os.X_OK):
            subprocess.run([TALLY_BIN, "clear", sid], capture_output=True, timeout=10)
    except (OSError, subprocess.TimeoutExpired):
        pass
    if f.exists():
        f.unlink(missing_ok=True)
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        sys.exit(0)
