#!/usr/bin/python3
"""Claude Code Notification hook → a key on the Stream Deck, by KIND.

Claude Code sends several notification types through this one hook, and
only some of them mean the operator must act:

  permission_prompt       Claude cannot proceed without a yes   → BLOCKED (red)
  elicitation_*dialog,
  agent_needs_input       something is asking a question        → ATTENTION (amber)
  idle_prompt             "waiting for your input" — the turn is simply over;
                          the session source already paints that green
                                                                → nothing
  auth_success, agent_completed, elicitation_complete/response,
  quota_*                 informational                         → nothing

The first version raised BLOCKED for every type, so every normally finished
session went red sixty seconds after it stopped talking.

Writes the signal into the PER-USER state dir (passwd home), not $HOME: a
second Claude account runs under its own HOME and its prompts must still
reach the hub. Override with TALLYDECK_STATE.
"""
import json, sys, time, os

BLOCKING = {"permission_prompt"}
ASKING = {"elicitation_dialog", "elicitation_url_dialog", "agent_needs_input"}


def state_dir():
    env = os.environ.get("TALLYDECK_STATE")
    if env:
        return os.path.expanduser(env)
    try:
        import pwd
        home = pwd.getpwuid(os.getuid()).pw_dir
    except Exception:
        home = os.path.expanduser("~")
    return os.path.join(home, ".tallydeck")


try:
    d = json.load(sys.stdin)
    sid = (d.get("session_id") or "")[:8]
    kind = str(d.get("notification_type") or "")
    msg = " ".join((d.get("message") or "").split())
    if not kind:
        # Older Claude Code: classify by the message text instead.
        low = msg.lower()
        if "permission" in low:
            kind = "permission_prompt"
        elif "waiting for your input" in low:
            kind = "idle_prompt"
        else:
            kind = "agent_needs_input"
    if kind in BLOCKING:
        state, prio = "blocked", 900
    elif kind in ASKING:
        state, prio = "attention", 700
    else:
        state = ""
    if sid and state:
        cwd = d.get("cwd") or ""
        home = os.environ.get("HOME", "")
        grok = bool(os.environ.get("GROK_AGENT")
                    or os.environ.get("GROK_SESSION_ID"))
        sid_full = str(d.get("session_id") or "")
        if not grok and sid_full:
            # Grok inherits Claude Code's Notification hook via compat. A
            # Grok session id lives under ~/.grok/sessions; labelling it as
            # Claude A is how the deck flashed "cruiser-finder / Tool
            # permission requested" for a headless grok.sh --single job.
            grok_root = os.path.expanduser("~/.grok/sessions")
            if os.path.isdir(grok_root):
                for dirpath, dirnames, _ in os.walk(grok_root):
                    if sid_full in dirnames:
                        grok = True
                        break
                    dirnames[:] = [n for n in dirnames if n != "terminal"]
        if grok:
            acct = "X"
            kind_headless = False
            try:
                grok_root = os.path.expanduser("~/.grok/sessions")
                for dirpath, dirnames, files in os.walk(grok_root):
                    if "summary.json" in files and os.path.basename(dirpath) == sid_full:
                        import json as _json
                        info = _json.loads(open(os.path.join(dirpath, "summary.json")).read())
                        kind_headless = str(info.get("session_kind") or "") == "headless"
                        break
            except Exception:
                kind_headless = False
            # Nobody can answer a headless permission prompt. Raising it as
            # blocked is how a scoring/fetch job shouted on the deck.
            if kind_headless and kind == "permission_prompt":
                state = ""
        else:
            # Second account = a session running under its own CLAUDE_CONFIG_DIR.
            # Set TALLY_ACCT_B_MARKER to whatever substring names yours.
            marker = os.environ.get("TALLY_ACCT_B_MARKER", ".claude-b")
            acct = "B" if marker in (os.environ.get("CLAUDE_CONFIG_DIR", "")
                                     or home) else "A"
        # The hook runs inside the session's process tree — if it lives in a
        # tmux pane, the pane's session name is the name the operator uses.
        label = ""
        pane = ""
        # `-t $TMUX_PANE`: a bare `display -p` names the CURRENT pane of the
        # attached client, so a prompt raised from a background session would
        # be labelled with, and route the operator to, whatever pane he
        # happens to be looking at.
        if os.environ.get("TMUX") and os.environ.get("TMUX_PANE"):
            import subprocess
            try:
                out = subprocess.run(
                    ["tmux", "display", "-p", "-t", os.environ["TMUX_PANE"], "#S|#S:#I.#P"],
                    capture_output=True, text=True, timeout=2).stdout.strip()
                label, _, pane = out.partition("|")
            except Exception:
                label = pane = ""
        msg = msg or "needs input"
        p = os.path.join(state_dir(), "signals")
        os.makedirs(p, exist_ok=True)
        with open(f"{p}/ask-{sid}.json", "w") as fh:
            json.dump({"label": label or os.path.basename(cwd) or ("grok" if grok else "claude"),
                       "state": state, "sublabel": msg[:40],
                       "detail": msg, "priority": prio, "ttl": 1800,
                       "updated": time.time(),
                       "meta": {"session": d.get("session_id") or "",
                                "project": cwd, "tmux": pane,
                                "account": acct, "kind": kind,
                                **({"harness": "grok"} if grok else {})}}, fh)
except Exception:
    pass
sys.exit(0)
