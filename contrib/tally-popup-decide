#!/usr/bin/env bash
# tally-popup-decide <signal-id> — put the decision TUI up where the operator is.
#
# The hub runs this as the default press action for a raised question. It cannot
# know which terminal window the operator is looking at (only the Mac can read
# window titles), and picking "the most recently active client" put the question
# in a window he was not watching. So: the popup goes up on EVERY attached client
# that is plausibly real (active in the last 12 h; mosh ghosts are weeks old;
# never on a _fl-* floating session, which would open it on top of itself).
# tally-decide notices when the flag is answered on one of them and folds the
# rest. Exit status: 0 if at least one popup went up, 1 if none could.
set -uo pipefail
SOCKET="${TALLY_TMUX_SOCKET:-/tmp/tmux-1000/cc}"
HERE="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
DECIDE="${TALLY_DECIDE:-}"
if [ -z "$DECIDE" ]; then
  for cand in "$HERE/tally-decide" "$HOME/.local/bin/tally-decide" \
              /home/openclaw/scripts/tally-decide.sh; do
    [ -x "$cand" ] && { DECIDE="$cand"; break; }
  done
fi
[ -n "$DECIDE" ] || { echo "tally-popup-decide: cannot find tally-decide" >&2; exit 2; }
LOG="${TALLY_POPUP_LOG:-$HOME/.openclaw/state/tally-popup.log}"
ID="${1:?usage: tally-popup-decide <signal-id>}"
log() { printf '[%s] %s\n' "$(date -u +%H:%M:%SZ)" "$*" >> "$LOG" 2>/dev/null || true; }
T() { tmux -S "$SOCKET" "$@"; }

NOW=$(date +%s)
PIDS=()
while IFS='|' read -r tty sess act; do
  [ -n "$tty" ] || continue
  case "$sess" in _fl-*) continue ;; esac
  [ $((NOW - ${act:-0})) -lt 43200 ] || continue          # ghost → skip
  log "popup for $ID on $tty ($sess)"
  T display-popup -c "$tty" -w 90% -h 85% -E "$DECIDE $(printf '%q' "$ID")" 2>>"$LOG" &
  PIDS+=($!)
done < <(T list-clients -F '#{client_tty}|#{client_session}|#{client_activity}' 2>/dev/null)

if [ "${#PIDS[@]}" -eq 0 ]; then
  log "no attached client — cannot show $ID"
  exit 1
fi
# Stay alive while any popup is up: the hub reads "still running after a beat"
# as "the popup is open" and stops the key flashing.
wait "${PIDS[@]}"
exit 0
