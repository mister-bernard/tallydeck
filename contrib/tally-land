#!/usr/bin/env bash
# tally-land <project> <session> [label] [state] — brief, then choose:
#   r      → resume the Claude session right here (respond directly)
#   enter  → shell in the project directory
# Used by the deck's fresh-window fallback when no live tmux pane exists.
export PYTHONPATH="${TALLYDECK_HOME:-$HOME/projects/tallydeck}${PYTHONPATH:+:$PYTHONPATH}"
PROJECT="${1:-$HOME}"; SESSION="${2:-}"; LABEL="${3:-}"; STATE="${4:-}"; ACCT="${5:-}"
BIN="claude"; [ "$ACCT" = "B" ] && BIN="$HOME/.local/bin/claude-b"
/usr/bin/python3 -m tallydeck.cli brief \
  --session "$SESSION" --project "$PROJECT" --label "$LABEL" --state "$STATE"
cd "$PROJECT" 2>/dev/null || cd "$HOME"
if [ -n "$SESSION" ]; then
  printf '  \033[1;38;2;0;229;255mr\033[0m resume here    \033[1;38;2;0;229;255m␣\033[0m done (mute alert)    \033[2many other key → shell\033[0m\n'
  IFS= read -r -n 1 -s key 2>/dev/null || key=""
  if [ "$key" = "r" ] || [ "$key" = "R" ]; then
    exec "$BIN" --dangerously-skip-permissions --resume "$SESSION"
  fi
  if [ "$key" = " " ]; then
    SID8=$(printf '%s' "$SESSION" | cut -c1-8)
    rm -f "$HOME/.tallydeck/signals/ask-$SID8.json"
    mkdir -p "$HOME/.tallydeck/acked"
    touch "$HOME/.tallydeck/acked/$SID8"
    printf '\n  \033[38;2;67;183;93m✓ muted\033[0m — it will flash again only when it asks anew\n'
    exit 0
  fi
fi
exec bash -l
